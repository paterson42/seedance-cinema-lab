# ─────────────────────────────────────────────────────────────
# Seedance Seoul Cinema Lab — 환경 설정
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# ARK_API_KEY 가 비어 있으면 자동으로 "데모(MOCK) 모드"로 동작합니다.
# ─────────────────────────────────────────────────────────────

PORT=3000
# 카카오톡 결과 링크 / 공유 링크에 들어갈 외부 접속 주소 (QR 코드가 가리킬 주소)
PUBLIC_BASE_URL=http://localhost:3000

# 개인정보(전화번호) 암호화 키. 비우면 data/.secret 에 자동 생성됩니다. 운영 시 반드시 고정값 사용.
APP_SECRET=
# 운영자 대시보드(/admin) 토큰. 비우면 부팅 시 자동 생성되어 콘솔에 출력됩니다.
ADMIN_TOKEN=

# ── BytePlus ModelArk (Seed / Seedream / Seedance) ──
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# 1 로 설정하면 API 키가 있어도 강제로 데모 모드
MOCK=0

# Seed LLM — 제목·로그라인·프롬프트 작성 (실패 시 템플릿으로 자동 대체)
SEED_LLM_MODEL=seed-1-6-250615
SEED_LLM_ENABLED=1

# Seedream — 포스터 이미지 (2:3)
SEEDREAM_MODEL=seedream-4-0-250828
SEEDREAM_SIZE=1280x1920
# 모델이 seed 파라미터를 지원하지 않으면 0 으로
SEEDREAM_SEND_SEED=1

# Seedance — 트레일러 영상 (image-to-video)
SEEDANCE_MODEL=seedance-1-0-pro-250528
SEEDANCE_RESOLUTION=720p
SEEDANCE_DURATION=10
SEEDANCE_SEND_SEED=1

# ── 큐 / 용량 ──
POSTER_CONCURRENCY=6
VIDEO_MAX_INFLIGHT=10
VIDEO_POLL_SEC=8
VIDEO_ETA_SEC=240
POSTER_MAX_PER_SESSION=3
VIDEO_MAX_PER_SESSION=2

# ── 카카오톡 결과 알림 ──
# mock    : 실제 발송 없이 운영자 대시보드 outbox 에 기록
# webhook : 아래 URL 로 JSON POST (알림톡 대행사/사내 발송 서버 연동용)
KAKAO_PROVIDER=mock
KAKAO_WEBHOOK_URL=
KAKAO_WEBHOOK_TOKEN=
KAKAO_TEMPLATE_CODE=SCL_TRAILER_READY
# 카카오 JavaScript 키 (설정 시 "카카오톡으로 공유" 버튼 활성화)
KAKAO_JS_KEY=

# ── 보관 기간 ──
RESULT_TTL_DAYS=14
RETENTION_DAYS=30

# ── 데모 모드 전용 ──
MOCK_POSTER_DELAY_SEC=4
MOCK_VIDEO_DELAY_SEC=25

# ── 현장 대형 스크린 (/screen/poster, /screen/trailer) ──
# 1 = 제출 즉시 상영 (운영자가 /admin 에서 숨기기 가능), 0 = 운영자 승인 후 상영
SCREEN_AUTO_APPROVE=1
# 지정하면 스크린 주소에 ?key=값 이 필요합니다
SCREEN_KEY=
